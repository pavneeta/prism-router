# Optional: used when routing to real providers via LiteLLM
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Together.ai — https://docs.together.ai/intro (LiteLLM: together_ai/...)
TOGETHER_API_KEY=
GROQ_API_KEY=
# Fireworks AI (LiteLLM accepts FIREWORKS_API_KEY or FIREWORKS_AI_API_KEY)
FIREWORKS_API_KEY=

# Model-Router / Prism Router
MODEL_ROUTER_CONFIG_DIR=config
MODEL_ROUTER_TELEMETRY_PATH=logs/telemetry.jsonl
MODEL_ROUTER_HOST=0.0.0.0
MODEL_ROUTER_PORT=4000
# Production: keep false (live provider calls)
MODEL_ROUTER_DRY_RUN=false

# Shadow-eval (keep false in production — roughly 2× spend)
MODEL_ROUTER_MIRROR_MODE=false
MODEL_ROUTER_MIRROR_PATH=logs/mirror.jsonl
MODEL_ROUTER_MIRROR_JUDGE=false
MODEL_ROUTER_MIRROR_JUDGE_MODEL=openai/gpt-4o-mini

# Public URL of this gateway (also stripped from provider *_API_BASE if leaked)
# MODEL_ROUTER_PUBLIC_BASE=https://<your-service>.up.railway.app

# Client API keys (comma-separated). Empty = open access (local default).
# REQUIRED on any internet-facing deploy — otherwise anyone can spend provider keys.
# MODEL_ROUTER_API_KEYS=pr_replace_me_with_a_long_random_string

# CORS: empty = off; "*" = all; or comma-separated origins
# MODEL_ROUTER_CORS_ORIGINS=https://prism-router-ten.vercel.app

# In-process rate limit (requests/minute/IP). 0 = off. Prefer Railway/edge limits too.
# MODEL_ROUTER_RATE_LIMIT_RPM=120

# Optional Redis for cross-replica session affinity (pip install '.[redis]')
# MODEL_ROUTER_REDIS_URL=redis://default:password@host:6379

# Outcome feedback JSONL for POST /v1/router/feedback
# MODEL_ROUTER_FEEDBACK_PATH=logs/feedback.jsonl

# Optional LLM second-pass classify when heuristic confidence < 0.7 (default off)
# MODEL_ROUTER_LLM_CLASSIFY=false
# MODEL_ROUTER_LLM_CLASSIFY_MODEL=openai/gpt-4o-mini
# MODEL_ROUTER_LLM_CLASSIFY_TIMEOUT=2.0

# Prompt cache / affinity knobs: config/policy.yaml

# Fail-closed public mode: requires client API keys and viable provider/fallback.
MODEL_ROUTER_PUBLIC_MODE=false
# Required to access global usage metrics when public/client auth is enabled.
MODEL_ROUTER_ADMIN_API_KEY=
# Streaming idle / total timeout seconds.
MODEL_ROUTER_STREAM_IDLE_TIMEOUT_SECONDS=30
MODEL_ROUTER_STREAM_TOTAL_TIMEOUT_SECONDS=300
